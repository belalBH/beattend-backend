// Settings Functions
function saveApiSettings(e) {
    e.preventDefault();
    const apiUrl = document.getElementById('apiUrl').value;
    localStorage.setItem('apiUrl', apiUrl);
    showAlert('تم حفظ الإعدادات بنجاح', 'success');
}

async function testApiConnection() {
    const apiUrl = document.getElementById('apiUrl').value;
    showAlert('جاري اختبار الاتصال...', 'info');
    
    try {
        const response = await fetch(apiUrl + '/employee/1');
        if (response.ok) {
            showAlert('الاتصال بالـ API ناجح!', 'success');
        } else {
            showAlert('فشل الاتصال بالـ API', 'danger');
        }
    } catch (error) {
        showAlert('خطأ في الاتصال: ' + error.message, 'danger');
    }
}

// Logout
function logout() {
    if (confirm('هل أنت متأكد من تسجيل الخروج؟')) {
        window.location.href = 'login.html';
    }
}

// Executive Status Badge Helper
function getStatusBadge(status) {
    switch (status) {
        case 'present':
        case 'approved':
        case 'active':
            return '<span class="badge-official badge-active"><i class="bi bi-check-circle-fill"></i> مكتمل / نشط</span>';
        case 'absent':
        case 'rejected':
            return '<span class="badge-official badge-inactive"><i class="bi bi-x-circle-fill"></i> غائب / مرفوض</span>';
        case 'late':
        case 'pending':
            return '<span class="badge-official badge-company" style="background:#fffbeb; color:#b45309; border-color:#fde68a;"><i class="bi bi-clock-history"></i> متأخر / معلق</span>';
        default:
            return `<span class="badge-official badge-company">${status || '-'}</span>`;
    }
}
