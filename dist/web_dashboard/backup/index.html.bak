<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BeatAttend HR Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <!-- Left Dark Sidebar Navigation -->
    <div class="sidebar-container">
        <div class="sidebar-profile">
            <div class="profile-avatar-wrapper">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80" alt="User Profile" class="profile-avatar">
            </div>
            <h4 class="profile-name">Abin Jose</h4>
            <div class="profile-role">Administrator</div>
        </div>

        <ul class="sidebar-menu">
            <!-- Dashboard Item -->
            <li class="sidebar-item">
                <a href="#" class="sidebar-link active" onclick="showPage('dashboard')">
                    <div class="link-content">
                        <i class="bi bi-grid-fill link-icon"></i>
                        <span>Dashboard</span>
                    </div>
                </a>
            </li>

            <!-- Email Item with Submenu -->
            <li class="sidebar-item">
                <a href="#" class="sidebar-link" onclick="toggleSubmenu('emailSubmenu')">
                    <div class="link-content">
                        <i class="bi bi-envelope-fill link-icon"></i>
                        <span>Email</span>
                        <span class="badge-pink ms-1">6</span>
                    </div>
                    <span class="sidebar-toggle-icon">−</span>
                </a>
                <ul class="sidebar-submenu" id="emailSubmenu">
                    <li>
                        <a href="#" class="submenu-link">
                            <span>Inbox</span>
                            <span class="badge-pink">6</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="submenu-link">
                            <span>Compose</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="submenu-link">
                            <span>Drafts</span>
                            <span class="badge-pink">6</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Calendar -->
            <li class="sidebar-item">
                <a href="#" class="sidebar-link" onclick="showPage('attendance')">
                    <div class="link-content">
                        <i class="bi bi-calendar-event-fill link-icon"></i>
                        <span>Calender</span>
                    </div>
                    <span class="sidebar-toggle-icon">+</span>
                </a>
            </li>

            <!-- Chart / Report -->
            <li class="sidebar-item">
                <a href="#" class="sidebar-link" onclick="showPage('reports')">
                    <div class="link-content">
                        <i class="bi bi-file-earmark-bar-graph-fill link-icon"></i>
                        <span>Chart/Report</span>
                    </div>
                    <span class="sidebar-toggle-icon">+</span>
                </a>
            </li>

            <!-- Media -->
            <li class="sidebar-item">
                <a href="#" class="sidebar-link" onclick="showPage('locations')">
                    <div class="link-content">
                        <i class="bi bi-image-fill link-icon"></i>
                        <span>Media</span>
                    </div>
                    <span class="sidebar-toggle-icon">+</span>
                </a>
            </li>

            <!-- Settings -->
            <li class="sidebar-item">
                <a href="#" class="sidebar-link" onclick="showPage('settings')">
                    <div class="link-content">
                        <i class="bi bi-gear-fill link-icon"></i>
                        <span>Settings</span>
                    </div>
                    <span class="sidebar-toggle-icon">+</span>
                </a>
            </li>

            <!-- Table -->
            <li class="sidebar-item">
                <a href="#" class="sidebar-link" onclick="showPage('employees')">
                    <div class="link-content">
                        <i class="bi bi-list-task link-icon"></i>
                        <span>Table</span>
                    </div>
                    <span class="sidebar-toggle-icon">+</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Main Wrapper Area -->
    <div class="main-wrapper">
        
        <!-- Top Metrics Cards Bar -->
        <div class="metrics-row">
            <!-- Card 1 -->
            <div class="metric-card">
                <div class="metric-icon-circle">
                    <i class="bi bi-eye"></i>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Total Views</div>
                    <div class="metric-value">234,675</div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="metric-card">
                <div class="metric-icon-circle">
                    <i class="bi bi-people"></i>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Total Candidates</div>
                    <div class="metric-value" id="todayPresent">146,689</div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="metric-card">
                <div class="metric-icon-circle">
                    <i class="bi bi-briefcase"></i>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Total Vacancies</div>
                    <div class="metric-value" id="todayAbsent">15,656</div>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="metric-card">
                <div class="metric-icon-circle">
                    <i class="bi bi-person-check"></i>
                </div>
                <div class="metric-info">
                    <div class="metric-label">Total Placed</div>
                    <div class="metric-value" id="todayLate">8,583</div>
                </div>
            </div>
        </div>

        <!-- JOBS LIST / DATA TABLE CARD -->
        <div class="table-card">
            <div class="table-card-header">
                <h3 class="table-card-title">JOBS LIST</h3>
                <div class="table-search-box">
                    <i class="bi bi-search table-search-icon"></i>
                    <input type="text" placeholder="Search" id="tableSearchInput" onkeyup="filterJobsTable()">
                </div>
            </div>

            <div class="custom-data-table-wrapper">
                <table class="custom-data-table">
                    <thead>
                        <tr>
                            <th>RECRUITER NAME <span class="sort-arrow">▼</span></th>
                            <th>JOB TITLE/POSITION <span class="sort-arrow">▼</span></th>
                            <th>NO OF OPENINGS <span class="sort-arrow">▼</span></th>
                            <th>LOCATION <span class="sort-arrow">▼</span></th>
                            <th>FULFILMENT DATE <span class="sort-arrow">▼</span></th>
                        </tr>
                    </thead>
                    <tbody id="jobsTableBody">
                        <!-- Default Rows Matching Screenshot -->
                        <tr>
                            <td>
                                <div class="company-cell">
                                    <img src="https://logo.clearbit.com/wipro.com" onerror="this.src='https://ui-avatars.com/api/?name=HCL&background=0D8ABC&color=fff'" class="company-logo" alt="HCL">
                                    <span>HCL Technologies</span>
                                </div>
                            </td>
                            <td>Applications Engineer</td>
                            <td>24</td>
                            <td>Bangalore</td>
                            <td>12/02/2017</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="company-cell">
                                    <img src="https://logo.clearbit.com/hp.com" onerror="this.src='https://ui-avatars.com/api/?name=HP&background=0096D6&color=fff'" class="company-logo" alt="HP">
                                    <span>HCL Soft Pvt. Ltd</span>
                                </div>
                            </td>
                            <td>Front End Developer</td>
                            <td>14</td>
                            <td>Chennai</td>
                            <td>15/02/2017</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="company-cell">
                                    <img src="https://logo.clearbit.com/dell.com" onerror="this.src='https://ui-avatars.com/api/?name=Dell&background=0076CE&color=fff'" class="company-logo" alt="Dell">
                                    <span>Dell India Pvt Ltd</span>
                                </div>
                            </td>
                            <td>Java Developer</td>
                            <td>17</td>
                            <td>Delhi</td>
                            <td>19/03/2017</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="company-cell">
                                    <img src="https://logo.clearbit.com/larsentoubro.com" onerror="this.src='https://ui-avatars.com/api/?name=LT&background=00529B&color=fff'" class="company-logo" alt="L&T">
                                    <span>L&T India</span>
                                </div>
                            </td>
                            <td>Programmer Analyst</td>
                            <td>12</td>
                            <td>Mumbai</td>
                            <td>17/02/2017</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="company-cell">
                                    <img src="https://logo.clearbit.com/bmw.com" onerror="this.src='https://ui-avatars.com/api/?name=BMW&background=000&color=fff'" class="company-logo" alt="BMW">
                                    <span>BMW Group</span>
                                </div>
                            </td>
                            <td>Web Administrator</td>
                            <td>22</td>
                            <td>Bangalore</td>
                            <td>12/03/2017</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="company-cell">
                                    <img src="https://logo.clearbit.com/skoda-auto.com" onerror="this.src='https://ui-avatars.com/api/?name=Skoda&background=4BA829&color=fff'" class="company-logo" alt="Skoda">
                                    <span>SKODA India</span>
                                </div>
                            </td>
                            <td>Systems Designer</td>
                            <td>12</td>
                            <td>Pune</td>
                            <td>09/2/2017</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Footer Pagination Bar -->
            <div class="table-card-footer">
                <div class="footer-left">
                    <span>Showing 06 Of 24</span>
                    <button class="page-size-select">Show 06 ▼</button>
                </div>
                <div class="footer-pagination">
                    <button class="pagination-btn"><i class="bi bi-caret-left-fill"></i> Prev</button>
                    <button class="pagination-btn">Next <i class="bi bi-caret-right-fill"></i></button>
                </div>
            </div>
        </div>

    </div>

    <!-- Hidden Employee Add/Edit Modal (Preserved for Backend Functionality) -->
    <div class="modal fade" id="addEmployeeModal" tabindex="-1" style="display:none;">
        <form id="addEmployeeForm">
            <input type="hidden" name="id" id="empFormId">
            <select name="company_id" id="empCompanySelect"><option value="1">1</option><option value="2">2</option></select>
            <input type="text" name="employee_number" id="empNumberInput">
            <input type="text" name="first_name" id="empFirstNameInput">
            <input type="text" name="last_name" id="empLastNameInput">
            <input type="email" name="email" id="empEmailInput">
            <input type="text" name="phone" id="empPhoneInput">
            <input type="password" name="password" id="empPasswordInput">
            <select name="assigned_location_id" id="empLocationSelect"><option value="1">1</option></select>
            <select name="department_id" id="empDepartmentSelect"><option value="1">1</option></select>
            <select name="status" id="empStatusSelect"><option value="active">active</option></select>
            <input type="checkbox" name="account_enabled" id="empAccountEnabled" value="1" checked>
        </form>
    </div>

    <script src="js/api.js"></script>
    <script src="js/app.js"></script>
    <script>
        function toggleSubmenu(id) {
            const el = document.getElementById(id);
            if (el) {
                el.style.display = (el.style.display === 'none') ? 'block' : 'none';
            }
        }
        function filterJobsTable() {
            const input = document.getElementById('tableSearchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#jobsTableBody tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
