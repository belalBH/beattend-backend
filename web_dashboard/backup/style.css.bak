/* =========================================================
 * Custom Dashboard UI - Exact Replica of Reference Image
 * ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap');

:root {
    --sidebar-bg: #1e262c;
    --sidebar-hover: #29333b;
    --sidebar-active: #2c3842;
    --sidebar-text: #bdc6ce;
    --sidebar-text-muted: #788793;
    
    --main-bg: #f0f3f6;
    --card-bg: #ffffff;
    --text-dark: #22252a;
    --text-muted: #6c757d;
    --border-color: #e5e9ec;
    --table-header-bg: #eef2f5;
    
    --pink-badge: #ff4081;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', 'Cairo', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: var(--main-bg);
    color: var(--text-dark);
    display: flex;
    min-height: 100vh;
    overflow-x: hidden;
}

/* =========================================================
 * 1. SIDEBAR (DARK LEFT NAVIGATION)
 * ========================================================= */
.sidebar-container {
    width: 250px;
    background-color: var(--sidebar-bg);
    color: var(--sidebar-text);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
}

/* User Profile Section */
.sidebar-profile {
    padding: 25px 20px 20px 20px;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.profile-avatar-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 12px;
}

.profile-avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #ffffff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

.profile-name {
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 2px 0;
}

.profile-role {
    color: var(--sidebar-text-muted);
    font-size: 0.82rem;
    font-weight: 500;
}

/* Navigation List */
.sidebar-menu {
    list-style: none;
    padding: 15px 0;
    margin: 0;
}

.sidebar-item {
    margin: 2px 0;
}

.sidebar-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    color: var(--sidebar-text);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: all 0.2s ease;
}

.sidebar-link:hover {
    background-color: var(--sidebar-hover);
    color: #ffffff;
}

.sidebar-link.active {
    background-color: var(--sidebar-active);
    color: #ffffff;
    font-weight: 600;
}

.link-content {
    display: flex;
    align-items: center;
    gap: 14px;
}

.link-icon {
    font-size: 1.1rem;
    width: 20px;
    text-align: center;
    color: var(--sidebar-text);
}

.badge-pink {
    background-color: var(--pink-badge);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 12px;
    line-height: 1;
}

.sidebar-toggle-icon {
    font-size: 0.8rem;
    color: var(--sidebar-text-muted);
    font-weight: bold;
}

/* Submenu Items */
.sidebar-submenu {
    list-style: none;
    padding: 0 0 5px 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0.15);
}

.submenu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 24px 9px 58px;
    color: #a0acb5;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s ease;
}

.submenu-link:hover {
    color: #ffffff;
}


/* =========================================================
 * 2. MAIN CONTENT AREA
 * ========================================================= */
.main-wrapper {
    flex-grow: 1;
    padding: 25px 30px;
    overflow-y: auto;
}

/* Metrics Cards Row */
.metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}

.metric-card {
    background-color: var(--card-bg);
    border-radius: 4px;
    padding: 22px 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--border-color);
}

.metric-icon-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #eef2f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    font-size: 1.6rem;
    flex-shrink: 0;
}

.metric-info {
    flex-grow: 1;
    text-align: right;
}

.metric-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-bottom: 4px;
}

.metric-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.1;
}

/* =========================================================
 * 3. JOBS LIST / DATA TABLE CONTAINER
 * ========================================================= */
.table-card {
    background-color: var(--card-bg);
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--border-color);
    padding: 24px 24px 15px 24px;
}

/* Header with Search */
.table-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
}

.table-card-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--text-dark);
    margin: 0;
}

.table-search-box {
    position: relative;
    width: 280px;
}

.table-search-box input {
    width: 100%;
    padding: 8px 12px 8px 36px;
    border: 1px solid #d1d9e0;
    border-radius: 3px;
    font-size: 0.88rem;
    outline: none;
    color: #333;
}

.table-search-box input:focus {
    border-color: #888;
}

.table-search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #999;
    font-size: 0.9rem;
}

/* Data Table Component */
.custom-data-table-wrapper {
    overflow-x: auto;
}

.custom-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
}

.custom-data-table thead th {
    background-color: var(--table-header-bg);
    color: #333333;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding: 14px 18px;
    text-align: left;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    white-space: nowrap;
}

.sort-arrow {
    display: inline-block;
    margin-left: 6px;
    font-size: 0.7rem;
    color: #444;
}

.custom-data-table tbody tr {
    border-bottom: 1px solid #edf1f4;
    transition: background-color 0.15s ease;
}

.custom-data-table tbody tr:hover {
    background-color: #f8fafc;
}

.custom-data-table tbody td {
    padding: 16px 18px;
    vertical-align: middle;
    color: #444;
}

/* Company Cell with Logo */
.company-cell {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    color: #222;
}

.company-logo {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    border: 1px solid #eee;
}

/* Table Footer / Pagination */
.table-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    margin-top: 10px;
    font-size: 0.88rem;
    color: var(--text-muted);
}

.footer-left {
    display: flex;
    align-items: center;
    gap: 15px;
}

.page-size-select {
    padding: 4px 10px;
    border: 1px solid #ccc;
    border-radius: 3px;
    background-color: #fff;
    font-size: 0.85rem;
    outline: none;
}

.footer-pagination {
    display: flex;
    align-items: center;
    gap: 15px;
}

.pagination-btn {
    background: none;
    border: none;
    color: #333;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
}

.pagination-btn:hover {
    color: #000;
}

/* Responsive adjustments */
@media (max-width: 1200px) {
    .metrics-row {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    body {
        flex-direction: column;
    }
    .sidebar-container {
        width: 100%;
        min-height: auto;
    }
    .metrics-row {
        grid-template-columns: 1fr;
    }
}
