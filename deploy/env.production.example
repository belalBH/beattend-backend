# =========================================================
# BeatAttend Production Environment Configuration Template
# Server: Hostinger VPS (beattend.com)
# =========================================================

# Application Core
APP_ENV=production
APP_DEBUG=false
APP_NAME="BeatAttend Enterprise Platform"
APP_URL=https://beattend.com
API_BASE_URL=https://beattend.com/api
PORT=3000

# Firebase Configuration & Credentials
FIREBASE_PROJECT_ID="beattend-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@beattend-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRODUCTION_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_DATABASE_URL="https://beattend-app.firebaseio.com"
FIREBASE_STORAGE_BUCKET="beattend-app.appspot.com"

# Database Configuration (PHP PDO Fallback / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=time_attendance_db
DB_USER=beattend_user
DB_PASS="YOUR_PRODUCTION_MYSQL_PASSWORD_HERE"

# Authentication & Security Secrets
JWT_SECRET="YOUR_SUPER_SECRET_PRODUCTION_JWT_KEY_MIN_64_CHARS"
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=2592000

# CORS & Allowed Origins
ALLOWED_ORIGINS="https://beattend.com,https://www.beattend.com,http://localhost:3000"

# FCM (Firebase Cloud Messaging) Push Notifications
FCM_SERVER_KEY="YOUR_PRODUCTION_FCM_SERVER_KEY"

# Mail SMTP Configuration
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@beattend.com
MAIL_PASSWORD="YOUR_HOSTINGER_MAIL_PASSWORD"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@beattend.com
MAIL_FROM_NAME="BeatAttend System"
